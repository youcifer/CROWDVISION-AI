# CrowdVision AI - Git Ignore Rules

# Video Data Directories (Ignore uploads and processed outputs)
data/uploads/*
data/processed/*
!data/uploads/.gitkeep
!data/processed/.gitkeep

# Sample videos cache
data/sample/*
!data/sample/.gitkeep

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
